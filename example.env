# Pangolin machine client credentials from Clients → Machines.
PANGOLIN_ENDPOINT=https://pangolin.example.com
CLIENT_ID=
CLIENT_SECRET=

# Use the same API_KEY in WHMCS Console Proxy.
API_KEY=
WHMCS_IPS=203.0.113.10
# Dedicated Proxmox VPN ranges, including addresses reserved for future nodes.
PVE_ALLOWED_NETWORKS=10.20.0.0/16,10.30.0.0/16
PVE_ALLOWED_PORTS=8006
# Optional for servers without a fingerprint in WHMCS.
# PVE_CA_FILE=/etc/kvm-console/ca
ALLOWED_ORIGINS=https://my.zenyx.eu
TRUSTED_PROXIES=127.0.0.1/32
CLIENT_IP_VALIDATE=false
TOKEN_TTL=60
SESSION_MAX_DURATION=12h
MAX_SESSIONS=500
MAX_SESSIONS_PER_IP=10
LOG_LEVEL=info
